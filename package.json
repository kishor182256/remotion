{
  "name": "Remotion",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@remotion/cli": "4.0.539",
    "@remotion/media": "^4.0.539",
    "@remotion/three": "4.0.539",
    "@remotion/zod-types": "4.0.539",
    "postprocessing": "^6.39.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539",
    "three": "^0.187.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/react": "19.2.7",
    "@types/three": "^0.187.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "preview:orbit": "remotion studio src/index.ts",
    "render:orbit": "remotion render src/index.ts GestureOrbit out/orbit/gesture-orbit.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --concurrency=2",
    "validate:orbit": "node scripts/validate-orbit.mjs",
    "preview:boy": "remotion studio src/index.ts --composition=CharacterIntro",
    "render:boy": "remotion render src/index.ts CharacterIntro out/boy/character-intro.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --concurrency=2",
    "validate:boy": "node scripts/validate-character.mjs",
    "build": "remotion bundle",
    "model:export": "node scripts/run_export.mjs",
    "audio:voiceover": "node scripts/generate_doberman_voiceover.mjs",
    "audio:build-score": "python scripts/build_doberman_audio.py",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "allowScripts": {
    "esbuild": false
  }
}
